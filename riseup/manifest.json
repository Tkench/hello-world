{
  "manifest_version": 3,
  "name": "RiseUp",
  "version": "0.9.0",
  "description": "Design templates, interactive blocks, animation, styling, find and replace, and colour tools for Articulate Rise 360.",
  "minimum_chrome_version": "105",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "RiseUp",
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://fonts.googleapis.com/*", "https://fonts.gstatic.com/*"],
  "content_scripts": [
    {
      "matches": ["https://rise.articulate.com/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/shared/config.js",
        "src/shared/css.js",
        "src/shared/textRules.js",
        "src/shared/color.js",
        "src/shared/fonts.js",
        "src/shared/fontLoader.js",
        "src/shared/components.js",
        "src/shared/components-more.js",
        "src/shared/components-extra.js",
        "src/shared/components-layout.js",
        "src/shared/nav.js",
        "src/shared/course.js",
        "src/shared/widget.js",
        "src/runtime/riseup-runtime.js",
        "src/content/panel-css.js",
        "src/content/content.js"
      ]
    }
  ]
}
